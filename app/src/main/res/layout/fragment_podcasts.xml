<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="24dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kasie_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KASIE FM PODCASTS"
        android:textAppearance="@style/TextAppearance.Kasie.Section"
        android:textColor="@color/kasie_accent" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="On-demand conversations, interviews and special features."
        android:textColor="@color/kasie_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/podcast_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/kasie_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/podcast_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>
