<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kasie_background">

    <!-- Toolbar: logo + wordmark + search/call studio -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/kasie_toolbar"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/toolbar_logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/kasie_fm_logo"
                android:src="@drawable/kasi_fm_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KASIE FM"
                    android:textColor="@color/kasie_text_primary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="97.1 · Katlehong's Own"
                    android:fontFamily="monospace"
                    android:textColor="@color/kasie_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search" />

            <ImageView
                android:id="@+id/btn_call_studio"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:contentDescription="Call Kasie FM studio"
                android:src="@drawable/ic_phone" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/kasie_accent" />

    <!-- ===== LIVE HERO (yellow) — keeps player-bound IDs ===== -->
    <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/live_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_live_badge"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="STREAM LIVE"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08"
                    android:textColor="@color/kasie_accent"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp">

                        <Button
                            android:id="@+id/playPauseButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_play_circle"
                            android:stateListAnimator="@null"
                            android:text=" "
                            android:contentDescription="@string/play_action" />

                        <ImageView
                            android:id="@+id/playPauseIcon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:clickable="false"
                            android:focusable="false"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_play" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/hero_show_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading schedule..."
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:textColor="@color/kasie_text_on_accent"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/hero_show_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text=""
                            android:fontFamily="monospace"
                            android:textColor="#B3181500"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Current track block (title/artist bound to RadioService) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#33181500" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="CURRENT TRACK"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:textColor="#A6181500"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/title_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Kasie FM Live"
                    android:textStyle="bold"
                    android:textColor="@color/kasie_text_on_accent"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/artist_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Kasie FM"
                    android:textColor="#BF181500"
                    android:textSize="12sp" />
    </LinearLayout>

    <!-- Each destination owns its own vertical scroll container. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:name="com.kasiefm.HomeFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kasie_toolbar"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
