<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:paddingBottom="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/kasie_background" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMMUNITY" android:textAppearance="@style/TextAppearance.Kasie.Section" android:textColor="@color/kasie_accent" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_dark_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/community_live_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● PAUSED" android:textColor="@color/kasie_accent" android:textSize="11sp" android:typeface="monospace" />
                <TextView android:id="@+id/community_live_show_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:text="Kasie FM Live" android:textColor="@color/kasie_text_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/community_live_show_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/kasie_text_muted" android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/community_live_play_button" android:layout_width="48dp" android:layout_height="48dp" android:backgroundTint="@color/kasie_accent" android:text="▶" android:textColor="@color/kasie_text_on_accent" android:textSize="18sp" app:cornerRadius="0dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/message_studio_tab" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingBottom="8dp" android:text="MESSAGE STUDIO" android:textColor="@color/kasie_accent" android:textSize="12sp" android:textStyle="bold" />
                <View android:id="@+id/message_studio_indicator" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/kasie_accent" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/group_chats_tab" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingBottom="8dp" android:text="GROUP CHATS" android:textColor="@color/kasie_text_muted" android:textSize="12sp" android:textStyle="bold" />
                <View android:id="@+id/group_chats_indicator" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/kasie_outline" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/message_studio_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="MESSAGE STUDIO" android:textAppearance="@style/TextAppearance.Kasie.Section" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="What would you like to send?" android:textColor="@color/kasie_text_primary" android:textSize="14sp" android:textStyle="bold" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/request_type_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:singleSelection="true">
                <com.google.android.material.chip.Chip android:id="@+id/chip_song_request" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Song Request" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_birthday" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Birthday Shout-out" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_prayer" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prayer Request" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_announcement" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Community Announcement" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_other" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other" />
            </com.google.android.material.chip.ChipGroup>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/name_input_layout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="Your Name">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/name_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:id="@+id/song_fields_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="visible">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/song_title_input_layout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Song Title">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/song_title_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Artist (optional)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/artist_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/message_input_layout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Message" app:counterEnabled="true" app:counterMaxLength="500">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/message_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:inputType="textMultiLine" android:lines="4" android:maxLength="500" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/send_whatsapp_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:backgroundTint="@color/kasie_accent" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="SEND MESSAGE" android:textColor="@color/kasie_text_on_accent" android:textStyle="bold" app:cornerRadius="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/sms_button" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="SMS THE STUDIO" android:textColor="@color/kasie_text_primary" app:cornerRadius="8dp" app:strokeColor="@color/kasie_accent" />
            <com.google.android.material.button.MaterialButton android:id="@+id/call_button" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="4dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="CALL THE STUDIO" android:textColor="@color/kasie_text_primary" app:cornerRadius="8dp" app:strokeColor="@color/kasie_accent" />
        </LinearLayout>

        <LinearLayout android:id="@+id/group_chats_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="GROUP CHATS" android:textAppearance="@style/TextAppearance.Kasie.Section" />
            <LinearLayout android:id="@+id/live_show_chat_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_dark_card" android:clickable="true" android:focusable="true" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Live Show Chat" android:textColor="@color/kasie_text_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Chat with listeners during the current show." android:textColor="@color/kasie_text_muted" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/community_lounge_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_dark_card" android:clickable="true" android:focusable="true" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Community Lounge" android:textColor="@color/kasie_text_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="General Kasie FM community conversation." android:textColor="@color/kasie_text_muted" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/local_events_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_dark_card" android:clickable="true" android:focusable="true" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Local Events" android:textColor="@color/kasie_text_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Talk about events happening in the community." android:textColor="@color/kasie_text_muted" android:textSize="13sp" />
            </LinearLayout>
            <Space android:layout_width="match_parent" android:layout_height="88dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
