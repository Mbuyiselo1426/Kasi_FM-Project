<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:paddingBottom="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/kasie_background" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_community_player" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="11dp" android:paddingEnd="8dp" android:paddingBottom="11dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/community_live_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● PAUSED" android:textColor="@color/kasie_accent" android:textSize="11sp" android:typeface="monospace" />
                <TextView android:id="@+id/community_live_show_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:text="Kasie FM Live" android:textColor="@color/kasie_text_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/community_live_show_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/kasie_text_muted" android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/community_live_play_button" android:layout_width="44dp" android:layout_height="44dp" android:backgroundTint="@color/kasie_accent" android:text="▶" android:textColor="@color/kasie_text_on_accent" android:textSize="18sp" app:cornerRadius="0dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-black" android:text="COMMUNITY" android:textColor="@color/kasie_text_primary" android:textSize="22sp" />
            <View android:layout_width="44dp" android:layout_height="3dp" android:layout_marginTop="6dp" android:background="@color/kasie_accent" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/message_studio_tab" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="10dp" android:text="MESSAGE STUDIO" android:textColor="@color/kasie_accent" android:textSize="12sp" android:textStyle="bold" />
                <View android:id="@+id/message_studio_indicator" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/kasie_accent" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/group_chats_tab" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="10dp" android:text="GROUP CHATS" android:textColor="@color/kasie_text_muted" android:textSize="12sp" android:textStyle="bold" />
                <View android:id="@+id/group_chats_indicator" android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/kasie_outline" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/message_studio_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_message_studio_card" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="20dp" android:paddingEnd="16dp" android:paddingBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:letterSpacing="0.08" android:text="YOUR VOICE • ON KASIE FM" android:textColor="@color/kasie_accent" android:textSize="10sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:fontFamily="sans-serif-black" android:text="Send your shout-out\nor song request" android:textColor="@color/kasie_text_primary" android:textSize="23sp" android:lineSpacingExtra="1dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Pick a lane, tell us what’s happening, and the studio will get it." android:textColor="@color/kasie_text_muted" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:fontFamily="monospace" android:text="I WANT TO SEND A…" android:textColor="@color/kasie_text_secondary" android:textSize="10sp" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/request_type_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" app:chipSpacingHorizontal="7dp" app:chipSpacingVertical="8dp" app:singleSelection="true">
                <com.google.android.material.chip.Chip android:id="@+id/chip_song_request" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="40dp" android:checked="true" android:text="Song Request" android:textColor="@color/community_chip_text" app:chipBackgroundColor="@color/community_chip_background" app:chipCornerRadius="4dp" app:chipStrokeColor="@color/kasie_outline" app:chipStrokeWidth="1dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_birthday" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Birthday Shout-out" android:textColor="@color/community_chip_text" app:chipBackgroundColor="@color/community_chip_background" app:chipCornerRadius="4dp" app:chipStrokeColor="@color/kasie_outline" app:chipStrokeWidth="1dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_prayer" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Prayer Request" android:textColor="@color/community_chip_text" app:chipBackgroundColor="@color/community_chip_background" app:chipCornerRadius="4dp" app:chipStrokeColor="@color/kasie_outline" app:chipStrokeWidth="1dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_announcement" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Community Announcement" android:textColor="@color/community_chip_text" app:chipBackgroundColor="@color/community_chip_background" app:chipCornerRadius="4dp" app:chipStrokeColor="@color/kasie_outline" app:chipStrokeWidth="1dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_other" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Other" android:textColor="@color/community_chip_text" app:chipBackgroundColor="@color/community_chip_background" app:chipCornerRadius="4dp" app:chipStrokeColor="@color/kasie_outline" app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:fontFamily="monospace" android:text="YOUR DETAILS" android:textColor="@color/kasie_text_secondary" android:textSize="10sp" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/name_input_layout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Your name" app:boxBackgroundColor="@color/kasie_background" app:boxStrokeColor="@color/kasie_accent" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/name_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:id="@+id/song_fields_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="visible">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:fontFamily="monospace" android:text="THE TRACK" android:textColor="@color/kasie_text_secondary" android:textSize="10sp" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/song_title_input_layout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Song title" app:boxBackgroundColor="@color/kasie_background" app:boxStrokeColor="@color/kasie_accent" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/song_title_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Artist (optional)" app:boxBackgroundColor="@color/kasie_background" app:boxStrokeColor="@color/kasie_accent" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/artist_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:fontFamily="monospace" android:text="YOUR MESSAGE" android:textColor="@color/kasie_text_secondary" android:textSize="10sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Keep it real, clear, and ready for the airwaves." android:textColor="@color/kasie_text_muted" android:textSize="12sp" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/message_input_layout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Write your message" app:boxBackgroundColor="@color/kasie_background" app:boxStrokeColor="@color/kasie_accent" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp" app:counterEnabled="true" app:counterMaxLength="500">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/message_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:inputType="textMultiLine" android:lines="4" android:maxLength="500" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="READY WHEN YOU ARE" android:textColor="@color/kasie_accent" android:textSize="11sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/send_whatsapp_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp" android:backgroundTint="@color/kasie_accent" android:text="SEND MESSAGE" android:textColor="@color/kasie_text_on_accent" android:textStyle="bold" app:cornerRadius="3dp" app:icon="@drawable/ic_mic" app:iconGravity="textStart" app:iconTint="@color/kasie_text_on_accent" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Your message goes straight to the Kasie FM studio." android:textColor="@color/kasie_text_muted" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/sms_button" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:text="SMS" android:textColor="@color/kasie_text_primary" app:cornerRadius="3dp" app:strokeColor="@color/kasie_outline" />
                <com.google.android.material.button.MaterialButton android:id="@+id/call_button" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="5dp" android:layout_weight="1" android:text="CALL STUDIO" android:textColor="@color/kasie_text_primary" app:cornerRadius="3dp" app:strokeColor="@color/kasie_outline" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/group_chats_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:fontFamily="monospace" android:letterSpacing="0.08" android:text="ON THE LINE" android:textColor="@color/kasie_text_muted" android:textSize="10sp" />
            <LinearLayout android:id="@+id/live_show_chat_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_community_chat_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="84dp" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="10dp">
                <FrameLayout android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_community_icon_tile"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:contentDescription="Live show chat" android:src="@drawable/ic_community_chat" /></FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="LIVE NOW" android:textColor="@color/kasie_accent" android:textSize="10sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="LIVE SHOW CHAT" android:textColor="@color/kasie_text_primary" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="2" android:text="Chat with listeners during the current show." android:textColor="@color/kasie_text_muted" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="JOIN  ›" android:textColor="@color/kasie_accent" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/community_lounge_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:background="@drawable/bg_community_chat_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="84dp" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="10dp">
                <FrameLayout android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_community_icon_tile"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:contentDescription="Community lounge" android:src="@drawable/ic_community_group" /></FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="THE KASIE" android:textColor="@color/kasie_accent" android:textSize="10sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="COMMUNITY LOUNGE" android:textColor="@color/kasie_text_primary" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="2" android:text="General Kasie FM community conversation." android:textColor="@color/kasie_text_muted" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="JOIN  ›" android:textColor="@color/kasie_accent" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/local_events_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:background="@drawable/bg_community_chat_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="84dp" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="10dp">
                <FrameLayout android:layout_width="42dp" android:layout_height="42dp" android:layout_marginTop="1dp" android:background="@drawable/bg_community_icon_tile"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:contentDescription="Local events" android:src="@drawable/ic_community_event" /></FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="WHAT'S HAPPENING" android:textColor="@color/kasie_accent" android:textSize="10sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="LOCAL EVENTS" android:textColor="@color/kasie_text_primary" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="2" android:text="Talk about events happening in the community." android:textColor="@color/kasie_text_muted" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="JOIN  ›" android:textColor="@color/kasie_accent" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="18dp" android:background="@drawable/bg_dark_card" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:letterSpacing="0.06" android:text="SPONSORED / LOCAL PARTNER" android:textColor="@color/kasie_text_muted" android:textSize="10sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Reserved community space" android:textColor="@color/kasie_text_secondary" android:textSize="12sp" />
            </LinearLayout>
            <Space android:layout_width="match_parent" android:layout_height="24dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
